ARG BUN_VERSION=1.3.11

# ================================ BASE STAGE ================================
FROM oven/bun:${BUN_VERSION} AS base

WORKDIR /app

COPY package.json tsconfig.json prisma.config.ts ./


# Install the dependencies
RUN bun install 

#=============================== BUILDER STAGE ================================
FROM base AS builder
WORKDIR /app

COPY . .

# สั่ง generate Prisma Client โดยใส่ dummy DATABASE_URL ชั่วคราว
RUN DATABASE_URL="postgresql://dummy:dummy@localhost:5432/dummy" bunx prisma generate

# Build the application for production
ENV NODE_ENV=production
RUN bun run build 

# ลบ node_modules ตัวเดิม แล้วติดตั้งเฉพาะ Production dependencies เพื่อลดขนาด Image
RUN rm -rf node_modules
RUN bun install --production --frozen-lockfile

# ================================ FINAL STAGE ================================
FROM oven/bun:1 AS final
WORKDIR /app

ENV NODE_ENV=production

COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/dist ./dist
COPY package.json ./

# Expose the port (DigitalOcean will set PORT env var)
EXPOSE 3000

# Run the application
CMD ["bun","./dist/index.js"]