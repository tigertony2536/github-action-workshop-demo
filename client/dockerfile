ARG BUN_VERSION=1.3.11

# ================================ BUILDER STAGE ================================
FROM oven/bun:${BUN_VERSION} AS builder

WORKDIR /app

# คัดลอก package.json และ bun.lock เพื่อทำ caching dependencies
COPY package.json bun.lock* ./

# ติดตั้ง dependencies ทั้งหมดสำหรับ build
RUN bun install --frozen-lockfile

# คัดลอก source code ทั้งหมด
COPY . .

# รองรับ Build Arguments สำหรับตั้งค่า Environment Variables (เช่น URL ของ API)
ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL

# Build โปรเจกต์ React + Vite (ผลลัพธ์จะอยู่ที่โฟลเดอร์ dist)
RUN bun run build

# ================================ PRODUCTION STAGE ================================
FROM nginx:alpine AS final

# คัดลอกไฟล์ที่ build แล้วจาก builder stage ไปยัง web root ของ Nginx
COPY --from=builder /app/dist /usr/share/nginx/html

# คัดลอกการตั้งค่า Nginx (SPA fallback สำหรับ TanStack Router และ Gzip/Caching)
COPY nginx.conf /etc/nginx/conf.d/default.conf

# เปิด port 80 สำหรับ Web Server
EXPOSE 80

# รัน Nginx ใน foreground mode
CMD ["nginx", "-g", "daemon off;"]
